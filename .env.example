# Optional: if set, the backend can send real email instead of only opening a browser draft.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@example.com
SMTP_PASSWORD=use-an-app-password-not-your-account-password
SMTP_FROM=your-sending-account@example.com

